#!/usr/bin/env python3
"""Manage the small, repo-local state used by autonomous coding goals."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import uuid
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path


STATE_FILES = (
    "ACTIVE",
    "BLOCKED.md",
    "COMPLETE",
    "GOAL.md",
    "PAUSE",
    "PROGRESS.md",
    "VERIFY",
)


class GoalError(RuntimeError):
    pass


def now() -> str:
    return datetime.now(UTC).isoformat(timespec="seconds")


def git(root: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        ["git", "-C", str(root), *args],
        check=False,
        text=True,
        capture_output=True,
    )
    if check and result.returncode:
        raise GoalError(result.stderr.strip() or "Git command failed")
    return result


def repo_root(cwd: str | Path | None = None, *, required: bool = True) -> Path | None:
    here = Path(cwd or os.getcwd()).resolve()
    result = git(here, "rev-parse", "--show-toplevel", check=False)
    if result.returncode:
        if required:
            raise GoalError("agent-goal must run inside a Git repository")
        return None
    return Path(result.stdout.strip()).resolve()


def state_dir(root: Path) -> Path:
    return root / ".agent"


def write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.tmp")
    temporary.write_text(text, encoding="utf-8")
    temporary.replace(path)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def ensure_local_exclude(root: Path) -> None:
    result = git(root, "rev-parse", "--git-path", "info/exclude")
    exclude = Path(result.stdout.strip())
    if not exclude.is_absolute():
        exclude = root / exclude
    exclude.parent.mkdir(parents=True, exist_ok=True)
    current = exclude.read_text(encoding="utf-8") if exclude.exists() else ""
    pattern = "/.agent/"
    if any(line.strip() == pattern for line in current.splitlines()):
        return
    separator = "" if not current or current.endswith("\n") else "\n"
    with exclude.open("a", encoding="utf-8") as handle:
        handle.write(f"{separator}# agent-goal runtime state\n{pattern}\n")


def confined_path(root: Path, value: str) -> tuple[Path, str]:
    if not isinstance(value, str) or not value:
        raise GoalError("expected a non-empty repository path")
    candidate = Path(value)
    path = candidate if candidate.is_absolute() else root / candidate
    try:
        relative = path.relative_to(root)
    except ValueError as error:
        raise GoalError("path must be inside the repository") from error
    if not relative.parts or ".." in relative.parts:
        raise GoalError("path must be inside the repository without traversal")
    current = root
    for part in relative.parts:
        current = current / part
        if current.is_symlink():
            raise GoalError(f"symlinks are not allowed: {relative}")
    return path, str(relative)


def file_input(root: Path, value: str, *, executable: bool = False) -> dict:
    path, name = confined_path(root, value)
    if not path.is_file() or (executable and not os.access(path, os.X_OK)):
        raise GoalError(f"file is missing or not executable: {name}")
    return {"path": name, "sha256": sha256(path), "mode": stat.S_IMODE(path.stat().st_mode)}


def read_record(path: Path) -> dict:
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise GoalError(f"{path.name} must contain a JSON object")
    return data


def valid_digest(value: object) -> bool:
    return isinstance(value, str) and re.fullmatch(r"[a-f0-9]{64}", value) is not None


def validate_record(root: Path, data: dict) -> dict:
    if type(data.get("version")) is not int or data["version"] not in (1, 2):
        raise GoalError("unsupported ACTIVE format")
    if data.get("continuation", "hook") not in ("hook", "native", "pi"):
        raise GoalError("invalid continuation owner")
    if not valid_digest(data.get("verifier_sha256")):
        raise GoalError("invalid verifier digest")
    verifier = file_input(root, data.get("verifier"), executable=True)
    if verifier["sha256"] != data["verifier_sha256"]:
        raise GoalError("verifier changed after activation")
    goal, _ = confined_path(root, ".agent/GOAL.md")
    if not goal.is_file() or not goal.read_text(encoding="utf-8").strip():
        raise GoalError("create a non-empty .agent/GOAL.md before starting")
    snapshot = {"goal_sha256": sha256(goal), "verifier_mode": verifier["mode"]}
    if data["version"] == 2:
        if not isinstance(data.get("goal_id"), str) or not data["goal_id"]:
            raise GoalError("missing goal identity")
        if not valid_digest(data.get("goal_sha256")):
            raise GoalError("invalid goal digest")
        if any(data.get(key) != value for key, value in snapshot.items()):
            raise GoalError("goal or verifier mode changed after activation")
        inputs = data.get("verify_inputs")
        if not isinstance(inputs, list):
            raise GoalError("invalid verifier input inventory")
        names = set()
        for item in inputs:
            if not isinstance(item, dict) or not valid_digest(item.get("sha256")):
                raise GoalError("invalid verifier input")
            actual = file_input(root, item.get("path"))
            if actual != item or actual["path"] in names:
                raise GoalError("verifier input changed or is duplicated")
            names.add(actual["path"])
    return snapshot


def inspect_goal(root: Path) -> dict:
    result = {
        "status": "inactive", "continue": False,
        "verifier": None, "verifier_sha256": None,
    }
    try:
        directory, _ = confined_path(root, ".agent")
        if directory.exists() and not directory.is_dir():
            raise GoalError(".agent must be a directory")
        markers = set()
        for name in ("ACTIVE", "COMPLETE", "PAUSE", "BLOCKED.md"):
            path, _ = confined_path(root, f".agent/{name}")
            if path.exists():
                if not path.is_file() or not path.read_text(encoding="utf-8").strip():
                    raise GoalError(f"empty or invalid {name} marker")
                markers.add(name)
        if not markers:
            return result
        if {"PAUSE", "BLOCKED.md"} <= markers:
            raise GoalError("conflicting pause and blocker markers")
        if "COMPLETE" in markers:
            if markers & {"PAUSE", "BLOCKED.md"}:
                raise GoalError("completion conflicts with pause or blocker")
            receipt = read_record(directory / "COMPLETE")
            if (type(receipt.get("version")) is not int or receipt["version"] != 2
                    or not isinstance(receipt.get("active"), dict)):
                raise GoalError("completion has no verifiable receipt")
            if not isinstance(receipt.get("completed_at"), str) or not receipt["completed_at"]:
                raise GoalError("completion is missing its timestamp")
            data = receipt["active"]
            snapshot = validate_record(root, data)
            if any(receipt.get(key) != value for key, value in snapshot.items()):
                raise GoalError("completion receipt does not match goal/verifier inputs")
            if "ACTIVE" in markers and read_record(directory / "ACTIVE") != data:
                raise GoalError("completion receipt conflicts with ACTIVE")
            result["status"] = "complete"
        else:
            if "ACTIVE" not in markers:
                raise GoalError("pause or blocker has no ACTIVE record")
            data = read_record(directory / "ACTIVE")
            snapshot = validate_record(root, data)
            result["status"] = (
                "paused" if "PAUSE" in markers else "blocked" if "BLOCKED.md" in markers else "active"
            )
        result.update(
            verifier=data["verifier"], verifier_sha256=data["verifier_sha256"],
            continuation=data.get("continuation", "hook"), record=data,
            goal_id=data.get("goal_id"), goal_sha256=snapshot["goal_sha256"],
            verify_inputs=data.get("verify_inputs", []),
        )
        result["continue"] = result["status"] == "active"
    except (GoalError, OSError, ValueError, TypeError) as error:
        result.update(status="invalid", error=str(error), **{"continue": False})
    return result


def require_state(root: Path, *allowed: str) -> dict:
    state = inspect_goal(root)
    if state["status"] not in allowed:
        message = f"goal is {state['status']}; expected {' or '.join(allowed)}"
        raise GoalError(state.get("error", message))
    return state


def command_start(args: argparse.Namespace) -> int:
    root = repo_root()
    assert root is not None
    directory, _ = confined_path(root, ".agent")
    require_state(root, "inactive")
    ensure_local_exclude(root)

    goal, _ = confined_path(root, ".agent/GOAL.md")
    if not goal.is_file() or not goal.read_text(encoding="utf-8").strip():
        raise GoalError("create a non-empty .agent/GOAL.md before starting")
    verifier = file_input(root, args.verify, executable=True)
    verifier_name = verifier["path"]
    inputs = {item["path"]: item for item in (file_input(root, name) for name in args.verify_input)}

    changes = git(root, "status", "--porcelain").stdout.strip()
    if changes and not args.allow_dirty:
        raise GoalError("worktree is not clean; commit/stash it or pass --allow-dirty deliberately")

    directory.mkdir(parents=True, exist_ok=True)
    active = {
        "version": 2,
        "goal_id": str(uuid.uuid4()),
        "goal_sha256": sha256(goal),
        "started_at": now(),
        "continuation": args.continuation,
        "verifier": verifier_name,
        "verifier_sha256": verifier["sha256"],
        "verifier_mode": verifier["mode"],
        "verify_inputs": list(inputs.values()),
    }
    write_text(directory / "ACTIVE", json.dumps(active, indent=2) + "\n")
    if not (directory / "PROGRESS.md").exists():
        write_text(
            directory / "PROGRESS.md",
            "# Current\n\nNot started.\n\n# Completed\n\n- None yet.\n\n# Next\n\nRead GOAL.md and begin.\n",
        )
    print(f"Active goal started in {root}")
    print(f"Verifier: {verifier_name}")
    return 0


def command_status(args: argparse.Namespace) -> int:
    root = repo_root(required=False)
    state = inspect_goal(root) if root else {
        "status": "inactive", "continue": False, "verifier": None, "verifier_sha256": None,
    }
    state.pop("record", None)
    if args.json:
        print(json.dumps(state))
    else:
        print(f"Status: {state['status']}")
        if state["verifier"]:
            print(f"Verifier: {state['verifier']}")
        if "error" in state:
            print(f"Error: {state['error']}")
    # Invalid state is still a successful inspection; clients must read status.
    return 0


def command_complete(_: argparse.Namespace) -> int:
    root = repo_root()
    assert root is not None
    directory = state_dir(root)
    state = require_state(root, "active", "complete")
    if state["status"] == "complete":
        # Recover an interruption after receipt publication, before ACTIVE removal.
        (directory / "ACTIVE").unlink(missing_ok=True)
        print("Goal complete; verified receipt retained.")
        return 0
    active = state["record"]
    snapshot = validate_record(root, active)
    verifier, verifier_name = confined_path(root, active["verifier"])
    print(f"Running {verifier_name}...", flush=True)
    result = subprocess.run([str(verifier)], cwd=root, check=False)
    if result.returncode:
        raise GoalError(f"verification failed with exit code {result.returncode}")
    after = require_state(root, "active")
    if after["record"] != active or validate_record(root, active) != snapshot:
        raise GoalError("goal inputs changed during verification; completion refused")
    receipt = {"version": 2, "completed_at": now(), "active": active, **snapshot}
    write_text(directory / "COMPLETE", json.dumps(receipt, indent=2) + "\n")
    (directory / "ACTIVE").unlink()
    print("Goal complete; verification passed.")
    return 0


def command_block(args: argparse.Namespace) -> int:
    root = repo_root()
    assert root is not None
    require_state(root, "active")
    write_text(
        state_dir(root) / "BLOCKED.md",
        "# Blocked\n\n"
        f"## External dependency\n\n{args.reason}\n\n"
        f"## Evidence\n\n{args.evidence}\n\n"
        f"## Attempted alternatives\n\n{args.attempted}\n\n"
        f"## To unblock\n\n{args.unblock}\n",
    )
    print("Goal marked blocked with recovery details.")
    return 0


def command_pause(args: argparse.Namespace) -> int:
    root = repo_root()
    assert root is not None
    require_state(root, "active")
    if not sys.stdin.isatty() and not args.force:
        raise GoalError("pause is a manual escape hatch; run it from a terminal")
    write_text(state_dir(root) / "PAUSE", f"paused_at: {now()}\nreason: {args.reason}\n")
    print("Goal paused. Run 'agent-goal resume' to continue.")
    return 0


def command_resume(_: argparse.Namespace) -> int:
    root = repo_root()
    assert root is not None
    require_state(root, "paused", "blocked")
    for name in ("BLOCKED.md", "PAUSE"):
        marker = state_dir(root) / name
        if marker.exists():
            marker.unlink()
    print("Goal resumed.")
    return 0


def command_clear(args: argparse.Namespace) -> int:
    root = repo_root()
    assert root is not None
    directory, _ = confined_path(root, ".agent")
    if not args.force:
        if not sys.stdin.isatty():
            raise GoalError("refusing to clear state non-interactively without --force")
        answer = input("Remove current .agent goal state? [y/N] ").strip().lower()
        if answer not in {"y", "yes"}:
            print("Nothing removed.")
            return 0
    for name in STATE_FILES:
        path = directory / name
        if path.is_file() or path.is_symlink():
            path.unlink()
    try:
        directory.rmdir()
    except OSError:
        pass
    print("Current goal state cleared.")
    return 0


def command_hook_stop(_: argparse.Namespace) -> int:
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError:
        print(json.dumps({"systemMessage": "agent-goal Stop hook received invalid JSON"}))
        return 0

    if not isinstance(payload, dict):
        print(json.dumps({"systemMessage": "agent-goal Stop hook expected a JSON object"}))
        return 0
    root = repo_root(payload.get("cwd") or os.getcwd(), required=False)
    state = inspect_goal(root) if root else {"status": "inactive", "continue": False}
    if state["status"] == "invalid":
        print(json.dumps({"systemMessage": f"agent-goal state invalid: {state['error']}"}))
        return 0
    # Native /goal and Pi own continuation when explicitly selected. The hook
    # fallback permits one retry only: Codex's repeat-stop guard is not a durable loop.
    if (
        not state["continue"]
        or state.get("continuation") in ("native", "pi")
        or payload.get("stop_hook_active") is True
    ):
        print("{}")
        return 0

    reason = (
        "Continue the active goal in .agent/GOAL.md. Read .agent/PROGRESS.md, make "
        "and verify progress, then update the progress file. Run 'agent-goal complete' "
        "when all acceptance criteria pass; use 'agent-goal block' only for an "
        "unavailable external dependency, with evidence and a recovery action."
    )
    print(json.dumps({"decision": "block", "reason": reason}))
    return 0


def parser() -> argparse.ArgumentParser:
    command = argparse.ArgumentParser(prog="agent-goal", description=__doc__)
    subcommands = command.add_subparsers(dest="command", required=True)

    start = subcommands.add_parser("start", help="activate the prepared goal")
    start.add_argument("--verify", default="scripts/verify", metavar="PATH")
    start.add_argument("--allow-dirty", action="store_true")
    start.add_argument(
        "--verify-input", action="append", default=[], metavar="PATH",
        help="freeze an explicit helper file (repeatable; no implicit repository inventory)",
    )
    start.add_argument(
        "--continuation", choices=("native", "hook", "pi"), default="hook",
        help="continuation owner; native requires a separately activated Codex /goal",
    )
    start.set_defaults(handler=command_start)

    status = subcommands.add_parser("status", help="show the current lifecycle state")
    status.add_argument("--json", action="store_true")
    status.set_defaults(handler=command_status)

    complete = subcommands.add_parser("complete", help="verify and complete the goal")
    complete.set_defaults(handler=command_complete)

    blocked = subcommands.add_parser("block", help="record a genuine external blocker")
    blocked.add_argument("--reason", required=True)
    blocked.add_argument("--evidence", required=True)
    blocked.add_argument("--attempted", required=True)
    blocked.add_argument("--unblock", required=True)
    blocked.set_defaults(handler=command_block)

    pause = subcommands.add_parser("pause", help="manually pause the active goal")
    pause.add_argument("--reason", default="manual pause")
    pause.add_argument("--force", action="store_true", help=argparse.SUPPRESS)
    pause.set_defaults(handler=command_pause)

    resume = subcommands.add_parser("resume", help="remove pause or blocker state")
    resume.set_defaults(handler=command_resume)

    clear = subcommands.add_parser("clear", help="remove the current goal state")
    clear.add_argument("--force", action="store_true")
    clear.set_defaults(handler=command_clear)

    hook = subcommands.add_parser("hook-stop", help=argparse.SUPPRESS)
    hook.set_defaults(handler=command_hook_stop)
    return command


def main() -> int:
    args = parser().parse_args()
    try:
        return args.handler(args)
    except (GoalError, OSError, ValueError, TypeError) as error:
        print(f"agent-goal: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
