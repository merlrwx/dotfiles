{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '{{ .chezmoi.homeDir }}/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"{{ .chezmoi.homeDir }}/.local/bin/agent-goal\" hook-stop",
            "statusMessage": "Checking autonomous goal state",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
