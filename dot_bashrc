#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Load ble.sh early so it can integrate with the rest of this interactive shell.
if [[ -r "$HOME/.local/share/blesh/ble.sh" ]]; then
    source -- "$HOME/.local/share/blesh/ble.sh" --attach=none
fi

# Use vi-style editing in the shell
set -o vi

# Clear screen with Ctrl+l
bind -x '"\C-l":clear'

# Basic editor/browser
export EDITOR=nvim
export VISUAL=nvim
# Preserve a host-provided opener in remote environments (for example, VS Code
# Dev Containers); a container-local browser usually cannot open the host UI.

# Useful folders
export REPOS="$HOME/jd/20-29-code/repos"
export DOTFILES="$HOME/.dotfiles"

# Bash history
export HISTFILE="$HOME/.bash_history"
export HISTSIZE=25000
export HISTFILESIZE=25000
export HISTCONTROL=ignoreboth

# Aliases
alias v='nvim'
alias c='clear'
alias e='exit'
alias ..='cd ..'
alias repos='cd "$REPOS"'
alias dot='cd "$DOTFILES"'

alias ls='ls --color=auto'
alias ll='ls -la'
alias la='ls -lAh'

alias t='tmux'
alias gs='git status'
alias gp='git pull'
alias gl='git log --oneline --graph --decorate --all'

alias eb='vim ~/.bashrc'
alias sbr='source ~/.bashrc'

# Yazi's shell wrapper changes to the selected directory on quit.
y() {
    local tmp cwd
    tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
    command yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp"
    [[ "$cwd" != "$PWD" && -d "$cwd" ]] && builtin cd -- "$cwd"
    command rm -f -- "$tmp"
}

# Herdr restores Codex sessions with `codex resume <session-id>`.
# Keep normal Codex launches unchanged, but make restored sessions autonomous.
codex() {
    if [[ "$1" == "resume" ]]; then
        local arg
        for arg in "$@"; do
            if [[ "$arg" == "--yolo" ]]; then
                command codex "$@"
                return
            fi
        done
        command codex "$@" --yolo
        return
    fi

    command codex "$@"
}

# Keep the terminal launcher in sync before opening Herdr. The same launcher is
# used by the desktop entry below, so Rofi and shell launches behave alike.
herdr() {
    herdr-launch "$@"
}


# Add local scripts/apps and Go binaries to PATH without duplicating entries
# when this file is sourced again.
export GOPATH="${GOPATH:-$HOME/go}"
__dotfiles_prepend_path() {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$1:$PATH" ;;
    esac
}
__dotfiles_prepend_path "$HOME/.local/bin"
[[ -z ${GOROOT:-} ]] || __dotfiles_prepend_path "$GOROOT/bin"
__dotfiles_prepend_path "$GOPATH/bin"
export PATH
unset -f __dotfiles_prepend_path

# Fabric pattern aliases
for pattern_file in "$HOME"/.config/fabric/patterns/*; do
    [[ -f "$pattern_file" ]] || continue
    pattern_name="${pattern_file##*/}"
    alias_name="${FABRIC_ALIAS_PREFIX:-}${pattern_name}"

    [[ "$alias_name" =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$ ]] || continue
    printf -v pattern_argument '%q' "$pattern_name"
    alias "$alias_name=fabric --pattern $pattern_argument"
done

yt() {
    if [ "$#" -eq 0 ] || [ "$#" -gt 2 ]; then
        echo "Usage: yt [-t | --timestamps] youtube-link"
        echo "Use the '-t' flag to get the transcript with timestamps."
        return 1
    fi

    transcript_flag="--transcript"
    if [ "$1" = "-t" ] || [ "$1" = "--timestamps" ]; then
        transcript_flag="--transcript-with-timestamps"
        shift
    fi
    local video_link="$1"
    fabric -y "$video_link" $transcript_flag
}


# Kubernetes
alias k='kubectl'

# Bash completion
if [ -f /usr/share/bash-completion/bash_completion ]; then
    source /usr/share/bash-completion/bash_completion
fi

if [ -f /usr/share/bash-completion/completions/kubectl ]; then
    source /usr/share/bash-completion/completions/kubectl
elif command -v kubectl >/dev/null 2>&1; then
    __dotfiles_load_kubectl_completion() {
        unset -f __dotfiles_load_kubectl_completion
        source <(kubectl completion bash)
        complete -o default -F __start_kubectl k
        __start_kubectl "$@"
    }
    complete -o default -F __dotfiles_load_kubectl_completion kubectl k
fi

if declare -F __start_kubectl >/dev/null; then
    complete -o default -F __start_kubectl k
fi

# SSH agent
if [[ -z ${SSH_AUTH_SOCK:-} && -r "$HOME/.ssh/id_ed25519" ]]; then
    eval "$(ssh-agent -s)" >/dev/null
    ssh-add "$HOME/.ssh/id_ed25519" >/dev/null 2>&1
    if [[ -n ${TMUX:-} ]]; then
        tmux set-environment -g SSH_AUTH_SOCK "$SSH_AUTH_SOCK" 2>/dev/null
    fi
fi

# Auto-start tmux in Alacritty (only if not already in tmux)
if [[ -z "$TMUX" ]] && [[ "$TERM" == "alacritty" ]]; then
    exec tmux new-session -s main
fi

# mise
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi

# starship
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# Docker helpers
if command -v docker >/dev/null 2>&1; then
  alias dctx='docker context ls'
  alias dinfo="docker info | grep -Ei 'operating system|name|server version'"

  dnative() {
    if docker context inspect fedora-docker >/dev/null 2>&1; then
      docker context use fedora-docker
    elif docker context inspect default >/dev/null 2>&1; then
      docker context use default
    else
      echo "No native Docker context found."
    fi
  }

  drancher() {
    if docker context inspect rancher-desktop >/dev/null 2>&1; then
      docker context use rancher-desktop
    else
      echo "No rancher-desktop Docker context found."
    fi
  }
fi
if [[ -f "$HOME/.cargo/env" ]]; then
    . "$HOME/.cargo/env"
fi

# Show the cat and system summary once in each interactive terminal/session.
if command -v neofetch >/dev/null 2>&1 && [[ -t 1 ]]; then
    if [[ -z ${TMUX-} ]]; then
        command -v clear >/dev/null 2>&1 && clear
        neofetch
    elif command -v tmux >/dev/null 2>&1 &&
        [[ -z $(tmux show-option -qv @dotfiles_neofetch_shown 2>/dev/null) ]]; then
        tmux set-option -q @dotfiles_neofetch_shown 1 2>/dev/null && {
            command -v clear >/dev/null 2>&1 && clear
            neofetch
        }
    fi
fi

# Attach after shell configuration and prompt integrations are initialized.
[[ ${BLE_VERSION-} ]] && ble-attach
