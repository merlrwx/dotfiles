#!/usr/bin/env bash

set -euo pipefail

if [[ ! -f /etc/fedora-release ]]; then
    exit 0
fi

# Re-run when the bundled GTK theme or pinned icon source changes.
# GTK theme archive SHA-256: 5f492971fb0e564323aa81a79d35dafb0bf64ab85b966da69c41f43947954000
# Gruvbox GTK source: 578cd220b5ff6e86b078a6111d26bb20ec8c733f
# Source archive SHA-256: f45da23a6c4123148cf8f78983e391a86c2e2ee1b7a80aa66790f148cb9619bd

source_dir={{ .chezmoi.sourceDir | quote }}
theme_archive="$source_dir/assets/Gruvbox-Yellow-Dark-Compact-Medium.tar.gz"

if [[ ! -f "$theme_archive" ]]; then
    printf 'Missing bundled GTK theme: %s\n' "$theme_archive" >&2
    exit 1
fi

mkdir -p "$HOME/.themes"
tar -xzf "$theme_archive" -C "$HOME/.themes" --no-same-owner

icon_archive="$(mktemp /tmp/gruvbox-gtk-theme.XXXXXX.tar.gz)"
icon_staging="$(mktemp -d /tmp/gruvbox-icons.XXXXXX)"

curl -fL --retry 3 \
    --output "$icon_archive" \
    https://github.com/Fausto-Korpsvart/Gruvbox-GTK-Theme/archive/578cd220b5ff6e86b078a6111d26bb20ec8c733f.tar.gz

printf '%s  %s\n' \
    f45da23a6c4123148cf8f78983e391a86c2e2ee1b7a80aa66790f148cb9619bd \
    "$icon_archive" | sha256sum --check --status

tar -xzf "$icon_archive" \
    --directory "$icon_staging" \
    --strip-components=2 \
    'Gruvbox-GTK-Theme-578cd220b5ff6e86b078a6111d26bb20ec8c733f/icons/Gruvbox_Dark'

mkdir -p "$HOME/.local/share/icons/Gruvbox_Dark"
cp -a "$icon_staging/Gruvbox_Dark/." "$HOME/.local/share/icons/Gruvbox_Dark/"

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache --force "$HOME/.local/share/icons/Gruvbox_Dark"
fi

rm -r -- "$icon_staging"
rm -- "$icon_archive"

if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    gsettings set org.gnome.desktop.interface gtk-theme 'Gruvbox-Yellow-Dark-Compact-Medium'
    gsettings set org.gnome.desktop.interface icon-theme 'Gruvbox_Dark'
    gsettings set org.gnome.desktop.interface font-name 'JetBrains Mono 10'
fi

if command -v xdg-mime >/dev/null 2>&1; then
    xdg-mime default thunar.desktop inode/directory
fi
