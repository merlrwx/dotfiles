{{- $detectedProfile := "cli" -}}
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "fedora") -}}
{{- $detectedProfile = "fedora-sway" -}}
{{- end -}}
{{- $profile := get . "profile" | default $detectedProfile -}}
#!/usr/bin/env bash

set -euo pipefail

if [[ {{ $profile | quote }} != "fedora-sway" || ! -f /etc/fedora-release ]]; then
    exit 0
fi

# Gruvbox Material GTK source commit: bb306ae972273cbfcbf78f8b772662e8b0678d82
# Source archive SHA-256: 67126883eebaa480aa1ff85e3582aba1c2ea7b44ff41bc1afc139ee77ab05568

archive_sha=67126883eebaa480aa1ff85e3582aba1c2ea7b44ff41bc1afc139ee77ab05568
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
archive="$cache_dir/gruvbox-material-bb306ae972273cbfcbf78f8b772662e8b0678d82.tar.gz"
download=""
staging=""
cleanup() {
    [[ -z "$download" ]] || rm -f -- "$download"
    [[ -z "$staging" ]] || rm -rf -- "$staging"
}
trap cleanup EXIT
mkdir -p "$cache_dir"
staging="$(mktemp -d /tmp/gruvbox-material.XXXXXX)"

if [[ ! -f "$archive" ]] || ! printf '%s  %s\n' "$archive_sha" "$archive" | sha256sum --check --status; then
    download="$(mktemp "$cache_dir/gruvbox-material.XXXXXX")"
    curl -fL --retry 3 \
        --output "$download" \
        https://github.com/TheGreatMcPain/gruvbox-material-gtk/archive/bb306ae972273cbfcbf78f8b772662e8b0678d82.tar.gz

    printf '%s  %s\n' "$archive_sha" "$download" | sha256sum --check --status
    mv -f -- "$download" "$archive"
    download=""
fi

tar -xzf "$archive" \
    --directory "$staging" \
    --strip-components=1 \
    --no-same-owner \
    'gruvbox-material-gtk-bb306ae972273cbfcbf78f8b772662e8b0678d82/themes/Gruvbox-Material-Dark' \
    'gruvbox-material-gtk-bb306ae972273cbfcbf78f8b772662e8b0678d82/icons/Gruvbox-Material-Dark'

# The upstream GTK port uses Material's medium background. Shift its dark
# background, selection, and diff colors to Gruvbox Material's hard contrast.
for stylesheet in \
    "$staging/themes/Gruvbox-Material-Dark"/gtk-*/gtk.css \
    "$staging/themes/Gruvbox-Material-Dark"/gtk-2.0/gtkrc; do
    sed -i \
        -e 's/#1b1b1b/__GM_DIM__/g' \
        -e 's/#282828/__GM_BG0__/g' \
        -e 's/#32302f/__GM_BG1__/g' \
        -e 's/#3c3836/__GM_BG2__/g' \
        -e 's/#45403d/__GM_BG3__/g' \
        -e 's/#5a524c/__GM_BG5__/g' \
        -e 's/#3a3735/__GM_STATUS__/g' \
        -e 's/#4c3432/__GM_VIS_RED__/g' \
        -e 's/#4f422e/__GM_VIS_YELLOW__/g' \
        -e 's/#3b4439/__GM_VIS_GREEN__/g' \
        -e 's/#374141/__GM_VIS_BLUE__/g' \
        -e 's/#443840/__GM_VIS_PURPLE__/g' \
        -e 's/#402120/__GM_DIFF_RED__/g' \
        -e 's/#34381b/__GM_DIFF_GREEN__/g' \
        -e 's/#0e363e/__GM_DIFF_BLUE__/g' \
        -e 's/__GM_BG0__/#1d2021/g' \
        -e 's/__GM_BG1__/#282828/g' \
        -e 's/__GM_BG2__/#32302f/g' \
        -e 's/__GM_BG3__/#3c3836/g' \
        -e 's/__GM_BG5__/#504945/g' \
        -e 's/__GM_DIM__/#141617/g' \
        -e 's/__GM_STATUS__/#32302f/g' \
        -e 's/__GM_VIS_RED__/#442e2d/g' \
        -e 's/__GM_VIS_YELLOW__/#473c29/g' \
        -e 's/__GM_VIS_GREEN__/#333e34/g' \
        -e 's/__GM_VIS_BLUE__/#2e3b3b/g' \
        -e 's/__GM_VIS_PURPLE__/#3c333b/g' \
        -e 's/__GM_DIFF_RED__/#3c1f1e/g' \
        -e 's/__GM_DIFF_GREEN__/#32361a/g' \
        -e 's/__GM_DIFF_BLUE__/#0d3138/g' \
        "$stylesheet"
done

mkdir -p "$HOME/.themes" "$HOME/.local/share/icons"
cp -a "$staging/themes/Gruvbox-Material-Dark" "$HOME/.themes/"
cp -a "$staging/icons/Gruvbox-Material-Dark" "$HOME/.local/share/icons/"

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache --force "$HOME/.local/share/icons/Gruvbox-Material-Dark"
fi

if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    gsettings set org.gnome.desktop.interface gtk-theme 'Gruvbox-Material-Dark'
    gsettings set org.gnome.desktop.interface icon-theme 'Gruvbox-Material-Dark'
    gsettings set org.gnome.desktop.interface font-name 'IoskeleyMonoTerm Nerd Font Mono 10'
fi

if command -v fc-cache >/dev/null 2>&1; then
    fc-cache --force "$HOME/.local/share/fonts/IoskeleyMonoTermNerdFont"
fi

if command -v xdg-mime >/dev/null 2>&1; then
    xdg-mime default thunar.desktop inode/directory
fi
