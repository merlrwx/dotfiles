#!/usr/bin/env bash

set -euo pipefail

# Re-run when either managed configuration changes.
# herdr config: {{ include "dot_config/herdr/config.toml" | sha256sum }}
# codex config defaults: {{ include "dot_codex/create_private_config.toml.tmpl" | sha256sum }}
# codex hooks: {{ include "dot_codex/hooks.json.tmpl" | sha256sum }}
# Pi settings: {{ include "dot_pi/agent/settings.json.tmpl" | sha256sum }}

if ! command -v herdr >/dev/null 2>&1; then
    exit 0
fi

herdr config check

if command -v codex >/dev/null 2>&1; then
    herdr integration install codex
    hooks_file="$HOME/.codex/hooks.json"
    if [[ -f "$hooks_file" && -n "$(tail -c 1 "$hooks_file")" ]]; then
        printf '\n' >> "$hooks_file"
    fi
fi

if command -v pi >/dev/null 2>&1; then
    herdr integration install pi
fi
