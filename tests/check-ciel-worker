        fake.chmod(0o755)
        gh = binary / 'gh'
        gh.write_text('#!/usr/bin/env python3\nimport json, sys\nassert sys.argv[1:7] == ["api", "--hostname", "github.com", "--method", "GET", "repos/owner/repo"]\nprint("{\\"name\\":\\"repo\\"}")\n')
        gh.chmod(0o755)
        log = self.root / 'tool-log'
        env = {**os.environ, 'PATH': str(binary) + ':/usr/bin:/bin',
               'HERDR_ENV': '0', 'CIEL_TEST_LOG': str(log)}

        def cli(request, command='transport', task=None, expected=0):
            argv = [str(SOURCE), '--config', str(self.config), command]
            if task:
                argv.append(task)
            result = subprocess.run(argv, input=json.dumps(request), text=True, capture_output=True, env=env)
            self.assertEqual(result.returncode, expected, result.stdout + result.stderr)
            return json.loads(result.stdout)

        processes = [subprocess.Popen([str(SOURCE), '--config', str(self.config), 'transport'],
                                      stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                      text=True, env=env) for _ in range(2)]
        with ThreadPoolExecutor(max_workers=2) as pool:
            replies = list(pool.map(lambda process: process.communicate(json.dumps(self.request)), processes))
        self.assertTrue(all(process.returncode == 0 for process in processes), replies)
        first = json.loads(replies[0][0])
        self.assertEqual(first, json.loads(replies[1][0]))
        self.assertEqual(first, cli(self.request))
        self.assertEqual(len(log.read_text().splitlines()), 2)
        cli({}, 'run', 'work-one', expected=1)
        env['HERDR_ENV'] = '1'  # Fake pane environment, only for this offline test.
        launched = cli({}, 'run', 'work-one')
        self.assertEqual(launched['result']['status'], 'active')
        cli({}, 'run', 'work-one')
        entries = [json.loads(line) for line in log.read_text().splitlines()]
        self.assertEqual(sum(e['args'][:2] == ['worktree', 'create'] for e in entries), 1)
        self.assertEqual(entries[0]['herdr_env'], '0')
        self.assertEqual(entries[-1]['herdr_env'], '1')
        record = ciel.read_json(ciel.record_path(self.cfg, 'work-one'))
        root = Path(record['worktree'])
        (root / 'src/result').write_text('real integration result\n')
        completed = subprocess.run([str(binary / 'agent-goal'), 'complete'], cwd=root,
                                   env=env, text=True, capture_output=True)
        self.assertEqual(completed.returncode, 0, completed.stderr)
        (root / 'src/result').write_text('failing result\n')
        cli({'action': 'collect', 'task_id': 'work-one'}, expected=1)
        (root / 'src/result').write_text('real integration result\n')
        result = cli({'action': 'collect', 'task_id': 'work-one'})['result']
        self.assertTrue(result['ready'])
        self.assertIn('real integration result', result['patch'])
        cli({'action': 'github_read', 'repo': 'owner/repo', 'operation': 'repository'})


if __name__ == '__main__':
    unittest.main()
