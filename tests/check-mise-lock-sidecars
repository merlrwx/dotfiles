#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
test_root="$(mktemp -d)"
trap 'rm -rf -- "$test_root"' EXIT
test_source="$test_root/source"
test_home="$test_root/home"

mkdir -p "$test_source/dot_config" "$test_home"
cp -a "$repo_root/dot_config/mise" "$test_source/dot_config/mise"
chezmoi --source "$test_source" --destination "$test_home" apply

source_sidecars="$repo_root/dot_config/mise/dot_mise/locks/pipx-copier/9.18.2"
applied_sidecars="$test_home/.config/mise/.mise/locks/pipx-copier/9.18.2"
for sidecar in pyproject.toml uv.lock; do
    if [[ ! -f "$applied_sidecars/$sidecar" ]]; then
        printf 'chezmoi did not apply Mise Copier lock sidecar: %s\n' "$sidecar" >&2
        exit 1
    fi
    cmp "$source_sidecars/$sidecar" "$applied_sidecars/$sidecar"
done

printf 'Mise Copier lock sidecars are managed by chezmoi.\n'
