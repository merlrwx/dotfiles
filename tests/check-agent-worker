        selected_verifier = ".agent/VERIFY" if letter == "c" else f"scripts/verify-{letter}"
        (goals / f"phase-0{index}.md").write_text(
            contract(f"phase-0{index}", selected_verifier, f"component-{letter}.txt")
        )
    custom_verifier = goals / "phase-03.verify"
    custom_verifier.write_text(
        "#!/usr/bin/env bash\nset -euo pipefail\n[[ $(cat component-c.txt) == C ]]\n"
    )
    custom_verifier.chmod(0o755)

    fake_bin = temp / "bin"
    fake_bin.mkdir()
    fake_state = temp / "herdr.json"
    fake_herdr = fake_bin / "herdr"
    fake_herdr.write_text("""#!/usr/bin/env python3
import json, os, subprocess, sys
from pathlib import Path

state_file = Path(os.environ['FAKE_HERDR_STATE'])
state = json.loads(state_file.read_text()) if state_file.exists() else {'agents': {}, 'workspaces': {}}
args = sys.argv[1:]
def option(name):
    return args[args.index(name) + 1]
if args[:2] == ['agent', 'list']:
    print(json.dumps({'result': {'agents': [dict(item, name=name) for name, item in state['agents'].items()]}}))
elif args[:2] == ['workspace', 'get']:
    item = state['workspaces'][args[2]]
    print(json.dumps({'result': {'workspace': dict(item, workspace_id=args[2], worktree={'checkout_path': item['path']})}}))
elif args[:2] == ['workspace', 'list']:
    print(json.dumps({'result': {'workspaces': [dict(item, workspace_id=key, worktree={'checkout_path': item['path']}) for key,item in state['workspaces'].items()]}}))
elif args[:2] == ['pane', 'list']:
    item = state['workspaces'][option('--workspace')]
    print(json.dumps({'result': {'panes': [{'pane_id': item['pane']}] + item.get('extra_panes', [])}}))
elif args[:2] == ['tab', 'list']:
    item = state['workspaces'][option('--workspace')]
    print(json.dumps({'result': {'tabs': [{'tab_id': 'root-tab'}] + item.get('extra_tabs', [])}}))
elif args[:2] == ['worktree', 'create']:
    repo = option('--cwd')
    branch = option('--branch')
    base = option('--base')
    path = option('--path')
    label = option('--label')
    subprocess.run(['git', '-C', repo, 'worktree', 'add', '-q', '-b', branch, path, base], check=True)
    state["sequence"] = state.get("sequence", 0) + 1
    workspace_id = f"test-w{state['sequence']}"
    pane_id = f"{workspace_id}:p1"
    state['workspaces'][workspace_id] = {'repo': repo, 'path': path, 'name': label, 'pane': pane_id}
    state_file.write_text(json.dumps(state))
    if os.environ.get('FAKE_HERDR_LOSE_CREATE'):
        raise SystemExit('lost create response')
    print(json.dumps({'result': {'workspace': {'workspace_id': workspace_id}, 'root_pane': {'pane_id': pane_id}}}))
elif args[:2] == ['agent', 'start']:
    name = args[2]
    workspace_id = next(key for key,item in state['workspaces'].items() if item['pane'] == option('--pane'))
    blocked = os.environ.get('FAKE_HERDR_BLOCK_START')
    state['agents'][name] = {'agent_status': 'blocked' if blocked else 'idle', 'prompt': '',
        'pane_id': option('--pane'), 'workspace_id': workspace_id, 'agent': option('--kind'),
