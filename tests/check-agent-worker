    planned = json.loads(org_manifest.read_text())
    assert all(task["status"] == "queued" for task in planned["tasks"].values())
    assert planned["tasks"]["alpha"]["repository_id"] == first["repository_id"]
    assert planned["tasks"]["alpha"]["repository_id"] != planned["tasks"]["beta"]["repository_id"]
    assert all(Path(task["worktree"]).is_relative_to(central) for task in planned["tasks"].values())
    launched = json.loads(call_worker("launch", "--run-id", "org").stdout)
    assert {task["name"] for task in launched} == {"alpha", "beta"}
    assert json.loads(call_worker("launch", "--run-id", "org").stdout) == []
    assert call_worker("launch", "--run-id", "org", "--jobs", "4", check=False).returncode != 0
    third_ready = json.loads(call_worker("launch", "--run-id", "org", "--jobs", "3").stdout)
    assert [task["name"] for task in third_ready] == ["delta"]
    agents = json.loads(fake_state.read_text())["agents"]
    for task in launched:
        assert len(task["herdr_name"]) <= 32
        agent = agents[task["herdr_name"]]
        assert agent["argv"][-7:] == ["--", "--sandbox", task["permission_profile"], "--config", 'approval_policy="never"', "--enable", "goals"]
        assert agent["prompt"].startswith("/goal ")
        assert json.loads((Path(task["worktree"]) / ".agent/ACTIVE").read_text())["continuation"] == "native"
    # Cross-repository dependencies require integration, not unrelated Git ancestry.
    alpha = planned["tasks"]["alpha"]
    alpha_root = Path(alpha["worktree"])
    run([str(goal_cli), "complete"], cwd=alpha_root)
    alpha_patch = json.loads(call_worker("collect", "alpha", "--run-id", "org").stdout)
    assert Path(alpha_patch["patch_path"]).read_bytes() == b""
    assert json.loads(call_worker("launch", "--run-id", "org", "--jobs", "3").stdout) == []
    Path(alpha_patch["patch_path"]).write_text("tampered empty patch")
    assert call_worker("integrated", "alpha", "--run-id", "org", "--at", "HEAD",
                       "--checkout", str(repo), check=False).returncode != 0
    Path(alpha_patch["patch_path"]).write_bytes(b"")
    call_worker("integrated", "alpha", "--run-id", "org", "--at", "HEAD", "--checkout", str(repo))
    assert call_worker("collect", "alpha", "--run-id", "org", check=False).returncode != 0
    git(repo, "worktree", "remove", str(linked))
    assert not linked.exists()
    gamma = json.loads(call_worker("launch", "--run-id", "org", "--jobs", "3").stdout)
    assert [task["name"] for task in gamma] == ["gamma"]
    # Same repository dependencies must be in the chosen base.
    bad_base = call_worker("spawn", "--run-id", "org", "--repo", str(repo), "--name", "old-base",
        "--goal", str(goals / "phase-01.md"), "--verify", str(verify_ok), "--base", base,
        "--depends-on", "alpha", check=False)
    assert bad_base.returncode != 0 and "does not include" in bad_base.stderr
    unsupported = call_worker("spawn", "--run-id", "policies", "--repo", str(repo), "--name", "unsupported",
        "--goal", str(goals / "phase-01.md"), "--verify", str(verify_ok), "--kind", "pi",
        "--permission-profile", "read-only", check=False)
    assert unsupported.returncode != 0 and "unsupported" in unsupported.stderr
    # Lost create responses reconcile exact existing workspace/path/branch.
    environment["FAKE_HERDR_LOSE_CREATE"] = "1"
    lost = call_worker("spawn", "--run-id", "recover", "--repo", str(repo), "--name", "lost",
        "--goal", str(goals / "phase-01.md"), "--verify", str(verify_ok),
        "--permission-profile", "workspace-write", check=False)
    assert lost.returncode != 0
    environment.pop("FAKE_HERDR_LOSE_CREATE")
    recovered = json.loads(call_worker("retry", "lost", "--run-id", "recover").stdout)
    state = json.loads(fake_state.read_text())
    count = len(state["workspaces"])
    assert call_worker("retry", "lost", "--run-id", "recover").returncode == 0
    assert len(json.loads(fake_state.read_text())["workspaces"]) == count
    name = recovered["herdr_name"]
    expected_arguments = state["agents"][name]["argv"]
    state["agents"][name]["agent_status"] = "idle"
    fake_state.write_text(json.dumps(state))
    refused = call_worker("resume", "lost", "--run-id", "recover", check=False)
    assert refused.returncode != 0 and "Cannot attest effective permission" in refused.stderr
    state["agents"][name]["agent_status"] = "working"
    fake_state.write_text(json.dumps(state))
    # A same-name replacement in another pane must never receive prompts.
    state["agents"][name]["pane_id"] = "wrong-pane"
    fake_state.write_text(json.dumps(state))
    assert call_worker("resume", "lost", "--run-id", "recover", check=False).returncode != 0
    state["agents"][name]["pane_id"] = recovered["root_pane_id"]
    state["workspaces"][recovered["workspace_id"]]["path"] = str(repo)
    fake_state.write_text(json.dumps(state))
    assert call_worker("retry", "lost", "--run-id", "recover", check=False).returncode != 0
    state["workspaces"][recovered["workspace_id"]]["path"] = recovered["worktree"]
    del state["agents"][name]
    fake_state.write_text(json.dumps(state))
    call_worker("resume", "lost", "--run-id", "recover")
    state = json.loads(fake_state.read_text())
    assert state["agents"][name]["argv"] == expected_arguments
    # A blocked launch can be retried only after it is ready, without spawning twice.
    environment["FAKE_HERDR_BLOCK_START"] = "1"
    blocked = call_worker("spawn", "--run-id", "blocked", "--repo", str(repo), "--name", "blocked",
        "--goal", str(goals / "phase-01.md"), "--verify", str(verify_ok), check=False)
    environment.pop("FAKE_HERDR_BLOCK_START")
    assert blocked.returncode != 0
    assert call_worker("retry", "blocked", "--run-id", "blocked", check=False).returncode != 0
    blocked_task = json.loads((temp / "state/agent-runs/blocked.json").read_text())["tasks"]["blocked"]
    state = json.loads(fake_state.read_text())
    state["agents"][blocked_task["herdr_name"]]["agent_status"] = "idle"
    fake_state.write_text(json.dumps(state))
    refused = call_worker("retry", "blocked", "--run-id", "blocked", check=False)
    assert refused.returncode != 0 and "Cannot attest effective permission" in refused.stderr
    del state["agents"][blocked_task["herdr_name"]]
    fake_state.write_text(json.dumps(state))
    call_worker("retry", "blocked", "--run-id", "blocked")
    # Legacy marker text and invalid state never count as verified completion.
    beta_root = Path(planned["tasks"]["beta"]["worktree"])
    run([str(goal_cli), "complete"], cwd=beta_root)
    (beta_root / ".agent/COMPLETE").write_text("completed_at: legacy\n")
    assert call_worker("collect", "beta", "--run-id", "org", check=False).returncode != 0

    # Deferred same-repository tasks resolve HEAD only at first launch. Pinned
    # hashes remain pinned and cannot accidentally consume a later dependency.
    before_queue = git(repo, "rev-parse", "HEAD")
    queue_plan = temp / "queue-plan.json"
    queue_plan.write_text(json.dumps({"tasks": [
        {"name": "producer", "repo": str(repo), "goal": str(goals / "phase-01.md"), "verify": str(verify_ok)},
        {"name": "consumer", "repo": str(repo), "goal": str(goals / "phase-01.md"), "verify": "scripts/verify", "verify_input": ["scripts/verify-ab"], "depends_on": ["producer"]},
        {"name": "pinned", "repo": str(repo), "goal": str(goals / "phase-01.md"), "verify": str(verify_ok), "depends_on": ["producer"], "base": before_queue},
    ]}))
    call_worker("plan", "--run-id", "sequential", "--file", str(queue_plan))
    producer = json.loads(call_worker("launch", "--run-id", "sequential").stdout)
    assert [task["name"] for task in producer] == ["producer"]
    producer_root = Path(producer[0]["worktree"])
    (producer_root / "queue-result.txt").write_text("dependency result\n")
    run([str(goal_cli), "complete"], cwd=producer_root)
    collected = json.loads(call_worker("collect", "producer", "--run-id", "sequential").stdout)
    git(repo, "apply", collected["patch_path"])
    git(repo, "add", "queue-result.txt")
    git(repo, "commit", "-qm", "test: integrate queued producer")
    after_queue = git(repo, "rev-parse", "HEAD")
    call_worker("integrated", "producer", "--run-id", "sequential", "--at", "HEAD", "--checkout", str(repo))
    consumer = json.loads(call_worker("launch", "--run-id", "sequential").stdout)
    assert [task["name"] for task in consumer] == ["consumer"]
    assert consumer[0]["initial_base_commit"] == before_queue
    assert consumer[0]["base_commit"] == after_queue
    assert (Path(consumer[0]["worktree"]) / "queue-result.txt").read_text() == "dependency result\n"
    seq = json.loads((temp / "state/agent-runs/sequential.json").read_text())
    assert seq["tasks"]["pinned"]["status"] == "queued"
    assert seq["tasks"]["pinned"]["base_commit"] == before_queue
    assert call_worker("retry", "consumer", "--run-id", "sequential").returncode == 0
    assert json.loads((temp / "state/agent-runs/sequential.json").read_text())["tasks"]["consumer"]["base_commit"] == after_queue

    consumer_root = Path(consumer[0]["worktree"])
    inventory = json.loads((consumer_root / ".agent/ACTIVE").read_text())["verify_inputs"]
    # Even an internally valid activation must still match the worker contract.
    active_file = consumer_root / ".agent/ACTIVE"
    original_active = active_file.read_text()
    for field, value in (("verify_inputs", []), ("continuation", "pi")):
        record = json.loads(original_active)
        record[field] = value
        active_file.write_text(json.dumps(record))
        inspected = json.loads(call_worker("inspect", "consumer", "--run-id", "sequential").stdout)
        assert inspected["goal_state"] == "invalid", field
    active_file.write_text(original_active)
    assert [item["path"] for item in inventory] == ["scripts/verify-ab"]
    helper = consumer_root / "scripts/verify-ab"
    helper.write_text(helper.read_text() + "# changed pinned helper\n")
    assert run([str(goal_cli), "complete"], cwd=consumer_root, check=False).returncode != 0
    assert call_worker("collect", "consumer", "--run-id", "sequential", check=False).returncode != 0

    # Config roots never silently fall back to cwd, including malformed types.
    for setting in ('directory = ""', 'directory = "relative"', 'directory = 42', 'directory = ["/tmp"]', 'directory = '):
        herdr_config.write_text('[worktrees]\n' + setting + '\n')
        refused = call_worker("spawn", "--run-id", "bad-root", "--repo", str(repo), "--name", "bad-root",
            "--goal", str(goals / "phase-01.md"), "--verify", str(verify_ok), check=False)
        assert refused.returncode != 0 and ("root" in refused.stderr or "Invalid Herdr config" in refused.stderr)
    herdr_config.write_text(f'[worktrees]\ndirectory = "{central}"\n')
    for override in ("", "relative", "~someone/worktrees"):
        refused = call_worker("spawn", "--run-id", "bad-root", "--repo", str(repo), "--name", "bad-root",
            "--goal", str(goals / "phase-01.md"), "--verify", str(verify_ok), "--worktree-root", override, check=False)
        assert refused.returncode != 0 and "nonempty absolute or ~/" in refused.stderr
    environment.pop("HERDR_CONFIG_PATH")
    xdg = temp / "xdg"
    (xdg / "herdr").mkdir(parents=True)
    (xdg / "herdr/config.toml").write_text(herdr_config.read_text())
    environment["XDG_CONFIG_HOME"] = str(xdg)
    pinned = json.loads(call_worker("spawn", "--run-id", "inputs", "--repo", str(repo), "--name", "inputs",
        "--goal", str(goals / "phase-01.md"), "--verify", str(verify_ok),
        "--verify-input", "scripts/verify-a", "--verify-input", "scripts/verify-b").stdout)
    assert Path(pinned["worktree"]).is_relative_to(central)
    assert len(json.loads((Path(pinned["worktree"]) / ".agent/ACTIVE").read_text())["verify_inputs"]) == 2
    # Legacy task records remain readable but cannot authorize resource mutation.
    legacy = dict(pinned)
    legacy.pop("repository_id")
    legacy.pop("herdr_name")
    legacy_path = temp / "state/agent-runs/legacy.json"
    legacy_path.write_text(json.dumps({"version": 1, "run_id": "legacy", "repo": str(repo), "tasks": {"inputs": legacy}}))
    inspected = json.loads(call_worker("inspect", "inputs", "--run-id", "legacy").stdout)
    assert not inspected["identity_proven"] and inspected["task"]["name"] == "inputs"
    for verb in ("retry", "resume", "cleanup"):
        refused = call_worker(verb, "inputs", "--run-id", "legacy", check=False)
        assert refused.returncode != 0 and "identity proof" in refused.stderr

    # Plan typos never silently downgrade an explicitly intended restriction to
    # the full-access default, and validation is atomic for the whole plan.
    invalid_plan = temp / "invalid-plan.json"
    valid_entry = {"name": "valid", "repo": str(repo), "goal": str(goals / "phase-01.md"), "verify": str(verify_ok)}
    workspaces_before = json.loads(fake_state.read_text())["workspaces"]
    for invalid in (
        dict(valid_entry, name="bad", permissions="read-only"),
        dict(valid_entry, name="bad", permission_profile=["read-only"]),
        dict(valid_entry, name="bad", permission_profile="readonly"),
        dict(valid_entry, name="bad", depends_on="valid"),
        dict(valid_entry, name="bad", depends_on=[42]),
        dict(valid_entry, name="bad", verify_input="scripts/verify-a"),
        dict(valid_entry, name=42), "not an object",
    ):
        invalid_plan.write_text(json.dumps({"tasks": [valid_entry, invalid]}))
        rejected = call_worker("plan", "--run-id", "invalid-plan", "--file", str(invalid_plan), check=False)
        assert rejected.returncode != 0
        assert not (temp / "state/agent-runs/invalid-plan.json").exists()
    assert json.loads(fake_state.read_text())["workspaces"] == workspaces_before

    # A freshly verified different goal using the same verifier cannot satisfy
    # this worker's original task, nor can reactivation of identical goal text.
    pinned_root = Path(pinned["worktree"])
    original_goal = (pinned_root / ".agent/GOAL.md").read_text()
    (pinned_root / ".agent/ACTIVE").unlink()
    (pinned_root / ".agent/GOAL.md").write_text(original_goal + "\nDifferent task.\n")
    run([str(goal_cli), "start", "--verify", ".agent/VERIFY"], cwd=pinned_root)
    run([str(goal_cli), "complete"], cwd=pinned_root)
    assert call_worker("collect", "inputs", "--run-id", "inputs", check=False).returncode != 0
    (pinned_root / ".agent/COMPLETE").unlink()
    (pinned_root / ".agent/GOAL.md").write_text(original_goal)
    run([str(goal_cli), "start", "--verify", ".agent/VERIFY"], cwd=pinned_root)
    assert call_worker("resume", "inputs", "--run-id", "inputs", check=False).returncode != 0
    run([str(goal_cli), "complete"], cwd=pinned_root)
    assert call_worker("collect", "inputs", "--run-id", "inputs", check=False).returncode != 0

print("agent-worker checks passed.")
