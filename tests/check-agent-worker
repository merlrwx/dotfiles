    if os.environ.get('FAKE_HERDR_LOSE_REMOVE'):
        raise SystemExit('lost remove response')
    print(json.dumps({'ok': True}))
else:
    raise SystemExit(f"unexpected fake Herdr command: {args}")
""")
    fake_herdr.chmod(0o755)

