    # Cleanup refuses a still-working session, then preserves all ignored data in an archive.
    refusal = call_worker("cleanup", "phase-01", "--run-id", "three-phase", check=False)
    assert refusal.returncode != 0 and "live working" in refusal.stderr
    state = json.loads(fake_state.read_text())
