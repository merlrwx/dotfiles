#!/usr/bin/env python3
"""Measure a rendered prompt and real command round trips in an isolated PTY."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import pty
import select
import shutil
import signal
import statistics
import struct
import subprocess
import tempfile
import termios
import time


def sample(bashrc, cwd, tmux=False):
    with tempfile.TemporaryDirectory(prefix="bash-startup-") as temporary:
        rc = Path(temporary, "bashrc")
        instrumentation = (
            "__benchmark_prompt() { HISTFILE=/dev/null; PS1+='__BENCH_PROMPT__ '; }\n"
            "if declare -F blehook >/dev/null; then\n"
            "  blehook PRECMD+=__benchmark_prompt\n"
            "else\n"
            "  PROMPT_COMMAND+=(__benchmark_prompt)\n"
            "fi\n"
        )
        content = bashrc.read_text()
        attach = '[[ ${BLE_VERSION-} ]] && ble-attach'
        if attach in content:
            content = content.replace(attach, instrumentation + attach)
        else:
            content += "\n" + instrumentation
        rc.write_text(content)
        command = ["/bin/bash", "--noprofile", "--rcfile", str(rc), "-i"]
        socket = str(Path(temporary, "tmux.sock"))
        if tmux:
            executable = shutil.which("tmux")
            if not executable:
                raise RuntimeError("tmux is not installed")
            command = [executable, "-S", socket, "-f", str(Path.home() / ".tmux.conf"),
                       "new-session", "-s", "benchmark", *command]
        start = time.perf_counter()
        pid, fd = pty.fork()
        if pid == 0:
            os.chdir(cwd)
            env = dict(os.environ, TERM="xterm-256color", DOTFILES_BANNER_SHOWN="1")
            env.pop("TMUX", None)
            # Do not start an SSH agent during a benchmark.
            env.setdefault("SSH_AUTH_SOCK", "/tmp/bash-benchmark-no-agent")
            # The first prompt hook disables history writes after Bash has
            # loaded the real history, before we send synthetic commands.
            os.execve(command[0], command, env)
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 40, 160, 0, 0))
        pending = bytearray()

        def expect(marker):
            deadline = time.monotonic() + 15
            while marker not in pending:
                if time.monotonic() > deadline:
                    raise RuntimeError(f"Timed out waiting for {marker!r}: {pending[-1000:]!r}")
                if select.select([fd], [], [], 0.1)[0]:
                    chunk = os.read(fd, 65536)
                    if not chunk:
                        raise RuntimeError("Bash exited before becoming ready")
                    pending.extend(chunk)
                    queries = chunk.count(b"\x1b[6n")
                    if queries:
                        os.write(fd, b"\x1b[1;1R" * queries)
            end = pending.index(marker) + len(marker)
            del pending[:end]
            return time.perf_counter()

        try:
            prompt_at = expect(b"__BENCH_PROMPT__")
            os.write(fd, b"printf '\\nBENCH_%s\\n' EXECUTED\n")
            executed_at = expect(b"BENCH_EXECUTED")
            expect(b"__BENCH_PROMPT__")
            # Allow deferred editor initialization to finish before steady-state
            # measurements; the first-command metric includes that work.
            time.sleep(0.3)
            turns = []
            for _ in range(3):
                before = time.perf_counter()
                os.write(fd, b":\n")
                expect(b"__BENCH_PROMPT__")
                turns.append((time.perf_counter() - before) * 1000)
            return {
                "first_prompt_ms": (prompt_at - start) * 1000,
                "first_command_ms": (executed_at - start) * 1000,
                "prompt_roundtrip_ms": statistics.median(turns),
            }
        finally:
            if tmux:
                subprocess.run([executable, "-S", socket, "kill-server"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            os.close(fd)
            os.waitpid(pid, 0)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--bashrc", type=Path, default=Path.home() / ".bashrc")
    parser.add_argument("--cwd", type=Path, default=Path.cwd())
    parser.add_argument("--samples", type=int, default=5)
    parser.add_argument("--tmux", action="store_true", help="Include a private tmux server/client")
    args = parser.parse_args()
    if args.samples < 1:
        parser.error("--samples must be positive")
    results = [sample(args.bashrc.resolve(), args.cwd.resolve(), args.tmux) for _ in range(args.samples)]
    print(json.dumps({"median": {k: round(statistics.median(r[k] for r in results), 1)
                                for k in results[0]}, "samples": results}, indent=2))
